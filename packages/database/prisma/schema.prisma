datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. SAAS TENANCY & SUPER ADMIN
// ----------------------------------------------------

enum HospitalStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  BLOCKED
}

model Tenant {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  logoUrl           String?
  faviconUrl        String?
  phone             String?
  whatsappNumber    String?
  email             String?
  address           String?
  googleMapsUrl     String?
  status            HospitalStatus @default(ACTIVE)
  planId            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  domains           Domain[]
  users             User[]
  departments       Department[]
  doctors           Doctor[]
  patients          Patient[]
  appointments      Appointment[]
  medicines         Medicine[]
  labTests          LabTest[]
  labOrders         LabOrder[]
  invoices          BillingInvoice[]
  websiteSettings   WebsiteSettings?
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Domain {
  id         String   @id @default(uuid())
  tenantId   String
  domain     String   @unique
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("domains")
}

// ----------------------------------------------------
// 2. USER, RBAC & ROLES
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  tenantId     String?   // Null for Super Admin
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  roleId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id])
  doctor       Doctor?
  patient      Patient?

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  // Null for System Roles
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String
  code        String   @unique

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------
// 3. CLINICAL, DOCTORS & DEPARTMENTS
// ----------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctors     Doctor[]

  @@index([tenantId])
  @@map("departments")
}

model Doctor {
  id                  String   @id @default(uuid())
  tenantId            String
  userId              String   @unique
  departmentId        String
  specialization      String
  qualification       String
  registrationNumber  String
  consultationFee     Decimal  @db.Decimal(10, 2)
  followupFee         Decimal  @db.Decimal(10, 2)
  emergencyFee        Decimal  @db.Decimal(10, 2)
  status              Boolean  @default(true)

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User       @relation(fields: [userId], references: [id])
  department          Department @relation(fields: [departmentId], references: [id])
  schedules           DoctorSchedule[]
  appointments        Appointment[]
  consultations       Consultation[]

  @@index([tenantId])
  @@map("doctors")
}

model DoctorSchedule {
  id           String   @id @default(uuid())
  doctorId     String
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday...
  startTime    String   // "09:00"
  endTime      String   // "13:00"
  slotDuration Int      @default(15) // Minutes
  maxPatients  Int      @default(20)

  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_schedules")
}

// ----------------------------------------------------
// 4. PATIENT & APPOINTMENTS
// ----------------------------------------------------

model Patient {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String?  @unique
  mrn              String   // E.g. HSP-2026-000123
  fullName         String
  dob              DateTime
  gender           String
  bloodGroup       String?
  phone            String
  whatsapp         String?
  email            String?
  address          String?
  cnicPassport     String?
  emergencyContact String?
  allergies        String?
  medicalHistory   String?
  createdAt        DateTime @default(now())

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id])
  appointments     Appointment[]
  consultations    Consultation[]
  labOrders        LabOrder[]
  invoices         BillingInvoice[]

  @@unique([tenantId, mrn])
  @@index([tenantId])
  @@index([mrn])
  @@map("patients")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                String            @id @default(uuid())
  tenantId          String
  patientId         String
  doctorId          String
  appointmentNumber String
  appointmentDate   DateTime
  timeSlot          String
  status            AppointmentStatus @default(PENDING)
  fee               Decimal           @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime          @default(now())

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient    @relation(fields: [patientId], references: [id])
  doctor            Doctor     @relation(fields: [doctorId], references: [id])
  consultation      Consultation?

  @@index([tenantId])
  @@index([appointmentDate])
  @@map("appointments")
}

model Consultation {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  symptoms      String?
  diagnosis     String?
  clinicalNotes String?
  createdAt     DateTime @default(now())

  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        Doctor        @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]

  @@map("consultations")
}

model Prescription {
  id             String   @id @default(uuid())
  consultationId String
  createdAt      DateTime @default(now())

  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  items          PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String   // e.g. "500mg"
  frequency      String   // e.g. "1-0-1"
  duration       String   // e.g. "5 Days"
  instructions   String?

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

// ----------------------------------------------------
// 5. PHARMACY POS & INVENTORY
// ----------------------------------------------------

model Medicine {
  id           String   @id @default(uuid())
  tenantId     String
  brandName    String
  genericName  String
  manufacturer String?
  category     String?
  unitPrice    Decimal  @db.Decimal(10, 2)
  stockQuantity Int     @default(0)
  reorderLevel Int      @default(10)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches      MedicineBatch[]

  @@index([tenantId])
  @@map("medicines")
}

model MedicineBatch {
  id          String   @id @default(uuid())
  medicineId  String
  batchNumber String
  expiryDate  DateTime
  costPrice   Decimal  @db.Decimal(10, 2)
  salePrice   Decimal  @db.Decimal(10, 2)
  quantity    Int

  medicine    Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@map("medicine_batches")
}

// ----------------------------------------------------
// 6. LABORATORY & LIS
// ----------------------------------------------------

model LabTest {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  category       String
  sampleType     String
  price          Decimal  @db.Decimal(10, 2)
  referenceRange String?
  unit           String?

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("lab_tests")
}

model LabOrder {
  id          String   @id @default(uuid())
  tenantId    String
  patientId   String
  orderNumber String   @unique // E.g. LAB-2026-000123
  status      String   @default("PENDING") // PENDING, SAMPLE_COLLECTED, PROCESSING, COMPLETED
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id])
  items       LabOrderItem[]

  @@index([tenantId])
  @@map("lab_orders")
}

model LabOrderItem {
  id          String   @id @default(uuid())
  labOrderId  String
  labTestName String
  resultValue String?
  status      String   @default("PENDING")

  labOrder    LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@map("lab_order_items")
}

// ----------------------------------------------------
// 7. BILLING & INVOICING
// ----------------------------------------------------

model BillingInvoice {
  id            String   @id @default(uuid())
  tenantId      String
  patientId     String
  invoiceNumber String   @unique
  totalAmount   Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(10, 2)
  status        String   @default("UNPAID") // UNPAID, PARTIAL, PAID, REFUNDED
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@map("billing_invoices")
}

// ----------------------------------------------------
// 8. WEBSITE CMS & AUDIT LOGS
// ----------------------------------------------------

model WebsiteSettings {
  id              String  @id @default(uuid())
  tenantId        String  @unique
  heroTitle       String?
  heroSubtitle    String?
  aboutText       String?
  primaryColor    String  @default("#0284c7")
  metaTitle       String?
  metaDescription String?

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  module    String
  recordId  String?
  before    String?  @db.Text
  after     String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}
